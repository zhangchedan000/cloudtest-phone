#!/sbin/openrc-run
# 管家程序。启动参数（PP_ARGS）和访问令牌（PP_TOKEN）放 /etc/conf.d/prism-phone-agent（chmod 600，OpenRC 自动读），
# 这个文件里不放口令，模板见仓库 host/board/etc/conf.d/prism-phone-agent.example。
# supervise-daemon 守护：管家崩了 5 秒后自动拉起（以前 command_background，崩了要等重启才回来）。
name="prism-phone-agent"
description="cloudtest guanjia"
supervisor="supervise-daemon"
command="/opt/prism-phone/prism-phone-agent"
command_args="${PP_ARGS}"
pidfile="/run/prism-phone-agent.pid"
supervise_daemon_args="--stdout /var/log/pp-agent.log --stderr /var/log/pp-agent.log"
respawn_delay=5
respawn_max=0
export PP_TOKEN

depend() {
  need docker
  after net ntpd prism-phone-mihomo prism-phone-fan
}

start_pre() {
  if [ -z "$PP_ARGS" ]; then
    eerror "没有启动参数：在 /etc/conf.d/prism-phone-agent 里写 PP_ARGS（模板见 host/board/etc/conf.d/prism-phone-agent.example）"
    return 1
  fi
  case "$PP_ARGS" in *"0.0.0.0:"*)
    if [ "${#PP_TOKEN}" -lt 16 ] || [ "$PP_TOKEN" = "改成你自己的令牌" ]; then
      eerror "监听 0.0.0.0 时 PP_TOKEN 必须自己设、至少 16 位（/etc/conf.d/prism-phone-agent）"
      return 1
    fi ;;
  esac
  # 板子没有硬件时钟：开机先是 2024 年，等 ntpd 对上时间（最多 60 秒），免得 HTTPS / 订阅拉取失败、日志时间错乱
  i=0
  while [ "$(date +%Y)" -lt 2025 ] && [ "$i" -lt 60 ]; do sleep 1; i=$((i + 1)); done
  # local.d 在所有服务之后才跑：binder 设备和网络转发规则这里先补上（两个脚本都可重复执行）
  [ -e /dev/vndbinder ] || sh /etc/local.d/binder-nodes.start
  nft list table ip prism_redir >/dev/null 2>&1 || sh /etc/local.d/pp-redir.start
  load_kmods
  return 0
}

# 自己编的内核模块（踩坑 #129 / #134）：只在内核和编它们时一模一样时加载（kernel.txt 由 install.sh 写）。
# 都要在手机开机前加载：pp_mnt 要看着手机建触摸屏才知道是谁的。
extra_commands="kmods"
description_kmods="加载自己编的内核模块（WiFi 驱动 / pp_uts / pp_mnt）"
kmods() {
  load_kmods
}

load_kmods() {
  k=/opt/prism-phone/kmod
  [ "$(cat /proc/version)" = "$(cat "$k/kernel.txt" 2>/dev/null)" ] || return 0
  if [ ! -d /sys/module/wlan ] && [ ! -d /sys/module/mac80211_hwsim ] && [ -f "$k/wlan.ko" ]; then
    insmod "$k/wlan.ko" radios=0 || ewarn "虚拟 WiFi 驱动加载失败（手机走有线网）"
  fi
  for m in pp_uts pp_mnt; do
    [ -d "/sys/module/$m" ] || [ ! -f "$k/$m.ko" ] || insmod "$k/$m.ko" || ewarn "内核模块 $m 加载失败（手机里会多些痕迹，不影响开机）"
  done
}
