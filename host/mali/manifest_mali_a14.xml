<!-- 安卓14 Mali 图形栈的 VINTF 声明。放进 /vendor/etc/vintf/manifest/，
     redroid 启动时合并进 device manifest。少了这个，mapper@4.0 的 passthrough
     会被 hwservicemanager 拒绝（"mapper 4.x is not supported"），libGLES_mali
     拿不到 IMapper，SurfaceFlinger 崩。allocator 是 hwbinder service，由
     allocator@4.0-service.rc 拉起。 -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <fqname>@4.0::IAllocator/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.graphics.mapper</name>
        <transport arch="32+64">passthrough</transport>
        <fqname>@4.0::IMapper/default</fqname>
    </hal>
</manifest>
